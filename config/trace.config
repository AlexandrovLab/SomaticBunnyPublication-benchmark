// Run records for the benchmark. Passed to BOTH pipelines with `-c config/trace.config` so that the
// trace, report and timeline are produced the same way, with the same fields, by SomaticBunny and
// Sarek. The `cpus` and `memory` fields are what the reserved core-hour metric needs (METRICS.md);
// Nextflow's default trace does not include them.
def benchmark_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

trace {
    enabled = true
    file    = "trace-${benchmark_ts}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,queue,cpus,memory,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,hostname'
}
report {
    enabled = true
    file    = "report-${benchmark_ts}.html"
}
timeline {
    enabled = true
    file    = "timeline-${benchmark_ts}.html"
}
