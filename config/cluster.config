// Scheduler settings shared by BOTH pipelines, passed to each with `-c config/cluster.config`, so
// that the submission policy and the per-job ceilings are identical and wall-clock comparisons are
// not affected by them. SomaticBunny additionally receives the same ceilings through its own
// --max_cpus/--max_memory/--max_time parameters (set by its run scripts).
process {
    executor       = 'slurm'
    clusterOptions = '-p platinum -q hcp-ddp302 -A ddp302'   // partition, QoS, account
    resourceLimits = [ cpus: 64, memory: 900.GB, time: 240.h ] // ceiling for any single job
}

executor {
    queueSize       = 100       // jobs in the SLURM queue at once
    submitRateLimit = '10 sec'  // one submission every 10 seconds
}

// Conda environments are built on first use, per launch directory, for both pipelines.
conda.createTimeout = '6 h'
