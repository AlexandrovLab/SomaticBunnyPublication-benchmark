// Cluster overlay for nf-core/sarek 3.8.1 on TSCC, passed with `-c config/sarek_tscc.config`.
//
// Sarek is run as released; nothing of its configuration tree is copied. This file adds what the
// cluster needs (executor, queue, pacing, node limits) and the few resource changes listed below,
// each justified by the lab's own Sarek traces (runs/archive/, 30x to 90x). Everything else keeps
// Sarek's own requests (conf/base.config of the release).
process {
    executor       = 'slurm'
    clusterOptions = '-p platinum -q hcp-ddp302 -A ddp302'
    // largest allocation a job may ask for on the benchmark nodes; Sarek caps its requests to these
    resourceLimits = [ cpus: 64, memory: 900.GB, time: 240.h ]

    // Sarek retries a killed task once (maxRetries = 1) with doubled resources. In the 30x run
    // FreeBayes was killed up to three times for the same pair (exit 137) before succeeding, so one
    // retry does not get a run through; two more attempts are allowed for every process.
    maxRetries = 3

    // Observed peak RSS vs. Sarek's request (attempt 1 -> attempt 2):
    //   FREEBAYES                 15 GB at 90x   vs  6 GB -> 12 GB  (process_single): would fail twice
    //   BWAMEM2_MEM               43 GB          vs 30 GB -> 60 GB: every one of ~200 shards would be killed once
    //   GATK4_BASERECALIBRATOR    7.4 GB         vs  4 GB ->  8 GB: a share of the 200 shards killed once
    //   GATK4_CALCULATECONTAMINATION 18 GB       vs 12 GB -> 24 GB: killed once per pair
    // Requests raised so that the first attempt holds; the attempt multiplier is kept.
    withName: 'FREEBAYES' {
        memory = { 24.GB * task.attempt }
    }
    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        memory = { 64.GB * task.attempt }
    }
    withName: 'GATK4_BASERECALIBRATOR' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'GATK4_CALCULATECONTAMINATION' {
        memory = { 24.GB * task.attempt }
    }
}

executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
}

// Conda environments are built on first use, per launch directory, as for SomaticBunny.
conda.createTimeout = '1 h'
