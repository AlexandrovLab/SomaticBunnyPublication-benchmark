// Resource overlay for nf-core/sarek 3.8.1, passed with `-c config/sarek_resources.config` after
// config/cluster.config. Sarek is run as released; every request below that is not listed here
// is Sarek's own (conf/base.config of the release). Each line is justified by the lab's earlier
// Sarek traces (runs/archive/, 30x to 90x). Documented in the manuscript Methods.
process {
    // Sarek retries a killed task once (maxRetries = 1) with doubled resources. In the 30x run
    // FreeBayes was killed up to three times for the same pair (exit 137) before succeeding, so one
    // retry does not get a run through; two more attempts are allowed for every process.
    maxRetries = 3

    // Observed peak RSS vs. Sarek's request (attempt 1 -> attempt 2):
    //   FREEBAYES                    15 GB at 90x  vs  6 GB -> 12 GB (process_single): would fail twice
    //   BWAMEM2_MEM                  43 GB         vs 30 GB -> 60 GB: every one of ~200 shards killed once
    //   GATK4_BASERECALIBRATOR       7.4 GB        vs  4 GB ->  8 GB: a share of the 200 shards killed once
    //   GATK4_CALCULATECONTAMINATION 18 GB         vs 12 GB -> 24 GB: killed once per pair
    // Requests raised so that the first attempt holds; the attempt multiplier is kept; CPUs unchanged.
    withName: 'FREEBAYES' {
        memory = { 24.GB * task.attempt }
    }
    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        memory = { 64.GB * task.attempt }
    }
    withName: 'GATK4_BASERECALIBRATOR' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'GATK4_CALCULATECONTAMINATION' {
        memory = { 24.GB * task.attempt }
    }
}
